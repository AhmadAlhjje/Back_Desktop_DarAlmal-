NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mizan
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Optional: used only by the initial-admin seeder
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# استطلاع حالة الترخيص من قاعدة البيانات (ثوانٍ) — يدفع القفل/رفعه فوراً عبر SSE
LICENSE_POLL_SECONDS=10

# مفتاح لوحة التحكم لمسارات /platform/* (32 محرفاً فأكثر) — نفسه في dashboard/server/.env
PLATFORM_API_KEY=
# كود واسم المكتب الافتراضي الذي تُنسب إليه البيانات الموجودة عند هجرة تعدد المكاتب (اختياري)
DEFAULT_OFFICE_CODE=
DEFAULT_OFFICE_NAME=
